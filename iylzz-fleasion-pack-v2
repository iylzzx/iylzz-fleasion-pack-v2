local function applyAirslide()
    if type(setfflag) ~= "function" then
        error("This environment does not support setfflag.")
    end

    local success, err = pcall(function()
        setfflag("ExtraFloorRaycastDistanceHipHeightPercent", "99999999999")
        setfflag("TaskSchedulerTargetFps", "999999999999999999999")
    end)

    if success then
        mispStatus.Text = "Airslide applied. Close the executor to reset."
        print("[Delta] FFlags applied.")
    else
        mispStatus.Text = "Airslide failed: " .. tostring(err)
        warn("[Delta] Failed:", err)
    end
end

local hyperSlideConnection = nil
local hyperSlideCeilingPart = nil
local hyperSlideMechanics = nil

local function applyHyperslide()
    if hyperSlideConnection then
        hyperSlideConnection:Disconnect()
        hyperSlideConnection = nil
    end
    if hyperSlideCeilingPart then
        hyperSlideCeilingPart:Destroy()
        hyperSlideCeilingPart = nil
    end

    hyperSlideMechanics = nil

    task.spawn(function()
        repeat task.wait(0.1) until game:IsLoaded()
        task.wait(2)
        if unloaded then return end

        local playerScripts = player:WaitForChild("PlayerScripts")
        local controllers = playerScripts:WaitForChild("Controllers", 8)
        if not controllers then
            mispStatus.Text = "Hyperslide failed: Controllers not found."
            return
        end

        local mechanicsModule = controllers:WaitForChild("MechanicsController", 8)
        if not mechanicsModule then
            mispStatus.Text = "Hyperslide failed: MechanicsController not found."
            return
        end

        local ok, mechanics = pcall(require, mechanicsModule)
        if not ok then
            mispStatus.Text = "Hyperslide failed: " .. tostring(mechanics)
            return
        end

        if unloaded then return end
        hyperSlideMechanics = mechanics

        local ceilingPart = Instance.new("Part")
        ceilingPart.Name = "HyperSlideCeiling"
        ceilingPart.Size = Vector3.new(8, 0.3, 8)
        ceilingPart.Anchored = true
        ceilingPart.CanCollide = true
        ceilingPart.Transparency = 1
        ceilingPart.CanQuery = false
        ceilingPart.CanTouch = false
        ceilingPart.Material = Enum.Material.SmoothPlastic
        ceilingPart.Parent = workspace
        hyperSlideCeilingPart = ceilingPart

        mispStatus.Text = "Hyperslide applied."
    end)

    hyperSlideConnection = RunService.RenderStepped:Connect(function()
        local mechanics = hyperSlideMechanics
        local ceilingPart = hyperSlideCeilingPart
        if not mechanics or not ceilingPart or not ceilingPart.Parent then
            return
        end

        if mechanics._sliding_cooldown and mechanics._sliding_cooldown > 0 then
            mechanics._sliding_cooldown = 0
        end

        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            ceilingPart.CFrame = CFrame.new(
                root.Position + Vector3.new(0, 2.42, 0)
            )
        end
    end)
end

