local function applySkyChanger()
    if type(getcustomasset) ~= "function" then
        error("Your executor does not support getcustomasset.")
    end

    local assets = {}
    for _, fileName in ipairs(skyFiles) do
        local ok, asset = pcall(getcustomasset, fileName)
        if not ok or type(asset) ~= "string" then
            error("Missing or unreadable file: " .. fileName)
        end
        assets[fileName] = asset
    end

    if skyChangerConnection then
        skyChangerConnection:Disconnect()
        skyChangerConnection = nil
    end
    if textureDescendantConnection then
        textureDescendantConnection:Disconnect()
        textureDescendantConnection = nil
    end
    if customSky then
        customSky:Destroy()
        customSky = nil
    end

    skyAssets = assets

    local function createCustomSky()
        local sky = Instance.new("Sky")
        sky.Name = "iylzzCustomSky"
        sky.SkyboxBk = skyAssets["sky512_bk.jpg"]
        sky.SkyboxDn = skyAssets["sky512_dn.jpg"]
        sky.SkyboxFt = skyAssets["sky512_ft.jpg"]
        sky.SkyboxLf = skyAssets["sky512_lf.jpg"]
        sky.SkyboxRt = skyAssets["sky512_rt.jpg"]
        sky.SkyboxUp = skyAssets["sky512_up.jpg"]
        sky.Parent = Lighting
        return sky
    end

    customSky = createCustomSky()

    -- Rebuild it if a round transition removes the previous Sky instance.
    skyChangerConnection = RunService.RenderStepped:Connect(function()
        if not unloaded and (not customSky or customSky.Parent ~= Lighting) then
            if customSky then
                pcall(function() customSky:Destroy() end)
            end
            customSky = createCustomSky()
        end
    end)

    mispStatus.Text = "Sky Changer applied. Lighting unchanged."
end

