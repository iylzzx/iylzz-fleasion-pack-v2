-- iylzz FPS Boost. The supplied optimizer is wrapped with reversible
-- snapshots and a single managed DescendantAdded connection.
local Workspace = game:GetService("Workspace")
local fpsBoostEnabled = false -- persistent Auto Apply state
local fpsBoostApplied = false -- current-session snapshot is active
local fpsBoostConnection = nil
local fpsMapRescanToken = 0
local fpsOriginalProperties = {}
local fpsOriginalLighting = nil
local fpsOriginalQuality = nil

local function rememberFpsProperty(object, property)
    local snapshot = fpsOriginalProperties[object]
    if not snapshot then
        snapshot = {}
        fpsOriginalProperties[object] = snapshot
    end
    if snapshot[property] == nil then
        local ok, value = pcall(function()
            return object[property]
        end)
        if ok then
            snapshot[property] = value
        end
    end
end

local function optimizeFpsObject(obj)
    pcall(function()
        if obj:IsA("BasePart") then
            rememberFpsProperty(obj, "CastShadow")
            rememberFpsProperty(obj, "Reflectance")
            rememberFpsProperty(obj, "Material")
            obj.CastShadow = false
            obj.Reflectance = 0
            obj.Material = Enum.Material.SmoothPlastic
        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam")
            or obj:IsA("Fire")
            or obj:IsA("Smoke")
            or obj:IsA("Sparkles")
            or obj:IsA("PostEffect") then
            rememberFpsProperty(obj, "Enabled")
            obj.Enabled = false
        end
    end)
end

local function restoreFpsBoost()
    if fpsBoostConnection then
        fpsBoostConnection:Disconnect()
        fpsBoostConnection = nil
    end

    for object, properties in pairs(fpsOriginalProperties) do
        if object and object.Parent then
            for property, value in pairs(properties) do
                pcall(function()
                    object[property] = value
                end)
            end
        end
    end
    table.clear(fpsOriginalProperties)

    if fpsOriginalLighting then
        pcall(function()
            Lighting.GlobalShadows = fpsOriginalLighting.GlobalShadows
            Lighting.EnvironmentDiffuseScale = fpsOriginalLighting.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = fpsOriginalLighting.EnvironmentSpecularScale
        end)
        fpsOriginalLighting = nil
    end

    if fpsOriginalQuality ~= nil then
        pcall(function()
            settings().Rendering.QualityLevel = fpsOriginalQuality
        end)
        fpsOriginalQuality = nil
    end

    fpsBoostEnabled = false
    fpsBoostApplied = false
    fpsAutoButton.Text = "Auto: OFF"
    fpsAutoButton.BackgroundColor3 = Color3.fromRGB(42, 48, 43)
end

local function applyFpsBoostOnce()
    if unloaded then
        error("The UI has been unloaded.")
    end
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    if fpsBoostApplied then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            optimizeFpsObject(obj)
        end
        return
    end

    fpsOriginalLighting = {
        GlobalShadows = Lighting.GlobalShadows,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    }
    pcall(function()
        fpsOriginalQuality = settings().Rendering.QualityLevel
    end)

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        optimizeFpsObject(obj)
    end

    fpsBoostApplied = true
    print("[iylzz FPS Boost] Applied for this session.")
end

local function enableFpsBoostAuto()
    applyFpsBoostOnce()
    fpsBoostEnabled = true

    if not fpsBoostConnection then
        fpsBoostConnection = Workspace.DescendantAdded:Connect(function(obj)
            if not fpsBoostEnabled or unloaded then
                return
            end

            -- Optimize new map objects immediately.
            optimizeFpsObject(obj)

            -- Then rescan after the map finishes streaming/building.
            -- The token makes this a quiet-period debounce.
            fpsMapRescanToken = fpsMapRescanToken + 1
            local thisToken = fpsMapRescanToken
            task.delay(1, function()
                if thisToken ~= fpsMapRescanToken
                    or not fpsBoostEnabled
                    or unloaded then
                    return
                end

                for _, descendant in ipairs(Workspace:GetDescendants()) do
                    optimizeFpsObject(descendant)
                end
                print("[iylzz FPS Boost] Refreshed for newly loaded map.")
            end)
        end)
    end

    fpsAutoButton.Text = "Auto: ON"
    fpsAutoButton.BackgroundColor3 = Color3.fromRGB(45, 105, 58)
    performStatus.Text = "FPS Boost Auto Apply enabled."
end

fpsApplyButton.MouseButton1Click:Connect(function()
    performStatus.Text = "Applying FPS Boost for this session..."
    local ok, err = pcall(applyFpsBoostOnce)
    if ok then
        performStatus.Text = "FPS Boost applied temporarily for this session."
    else
        performStatus.Text = "FPS Boost failed: " .. tostring(err)
        warn("[iylzz FPS Boost] " .. tostring(err))
    end
end)

local fpsAutoSaved = persistentAutoApply["Perform: FPS Boost"] == true
local fpsAutoState = {
    enabled = fpsAutoSaved,
    button = fpsAutoButton,
    apply = enableFpsBoostAuto
}
autoApplyStates["Perform: FPS Boost"] = fpsAutoState
if fpsAutoSaved then
    fpsAutoButton.Text = "Auto: ON"
    fpsAutoButton.BackgroundColor3 = Color3.fromRGB(45, 105, 58)
end

fpsAutoButton.MouseButton1Click:Connect(function()
    fpsAutoState.enabled = not fpsAutoState.enabled
    persistentAutoApply["Perform: FPS Boost"] = fpsAutoState.enabled
    saveAutoApplyStates()

    if fpsAutoState.enabled then
        local ok, err = pcall(enableFpsBoostAuto)
        if not ok then
            fpsAutoState.enabled = false
            persistentAutoApply["Perform: FPS Boost"] = false
            saveAutoApplyStates()
            fpsAutoButton.Text = "Auto: OFF"
            fpsAutoButton.BackgroundColor3 = Color3.fromRGB(42, 48, 43)
            performStatus.Text = "FPS Boost Auto Apply failed: " .. tostring(err)
            warn("[iylzz FPS Boost] " .. tostring(err))
        end
    else
        restoreFpsBoost()
        performStatus.Text = "FPS Boost Auto Apply disabled; settings restored."
    end
end)

local function unloadAll()
    if unloaded then
        return
    end
    unloaded = true

    if fpsBoostApplied or fpsBoostEnabled or fpsBoostConnection
        or next(fpsOriginalProperties) ~= nil then
        restoreFpsBoost()
    end

    if skyChangerConnection then
        skyChangerConnection:Disconnect()
        skyChangerConnection = nil
    end
    if customSky then
        customSky:Destroy()
        customSky = nil
    end
    if hyperSlideConnection then
        hyperSlideConnection:Disconnect()
        hyperSlideConnection = nil
    end
    if hyperSlideCeilingPart then
        hyperSlideCeilingPart:Destroy()
        hyperSlideCeilingPart = nil
    end
    hyperSlideMechanics = nil
    -- Stop this menu's respawn auto-apply behavior.
    for label, state in pairs(autoApplyStates) do
        state.enabled = false
        persistentAutoApply[label] = false
    end
    saveAutoApplyStates()
    if characterConnection then
        characterConnection:Disconnect()
        characterConnection = nil
    end

    -- Restore BasePart properties changed by Dark Texture.
    for part, properties in pairs(originalPartProperties) do
        if part and part.Parent then
            pcall(function()
                part.Color = properties.Color
                part.Material = properties.Material
            end)
        end
    end

    -- Restore texture visibility changed by No Texture.
    for textureObject, transparency in pairs(originalTextureProperties) do
        if textureObject and textureObject.Parent then
            pcall(function()
                textureObject.Transparency = transparency
            end)
        end
    end

    -- Reattach SurfaceAppearance instances hidden by No Texture.
    for surface, oldParent in pairs(originalSurfaceParents) do
        if surface and oldParent and oldParent.Parent then
            pcall(function()
                surface.Parent = oldParent
            end)
        end
    end

    -- Remove this menu and its toggle control.
    gui:Destroy()
end

