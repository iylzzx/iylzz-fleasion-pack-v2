local autoApplyStates = {}
local characterConnection = nil
local unloaded = false

-- Keep Auto Apply choices across script re-executions and place changes.
-- The executor environment is the primary store; file APIs are a fallback.
local autoApplyEnvironment = _G
pcall(function()
    if type(getgenv) == "function" then
        autoApplyEnvironment = getgenv()
    end
end)

local autoApplyStorageKey = "__iylzzVisualAutoApply"
local autoApplyFile = "iylzz_visual_autoapply.json"
local HttpService = game:GetService("HttpService")

local persistentAutoApply = autoApplyEnvironment[autoApplyStorageKey]
if type(persistentAutoApply) ~= "table" then
    persistentAutoApply = {}
end

local function loadAutoApplyFile()
    if type(readfile) ~= "function" then
        return
    end

    local ok, contents = pcall(function()
        if type(isfile) == "function" and not isfile(autoApplyFile) then
            return nil
        end
        return readfile(autoApplyFile)
    end)

    if ok and type(contents) == "string" and contents ~= "" then
        local decodedOk, decoded = pcall(function()
            return HttpService:JSONDecode(contents)
        end)
        if decodedOk and type(decoded) == "table" then
            for label, enabled in pairs(decoded) do
                if type(label) == "string" and type(enabled) == "boolean" then
                    persistentAutoApply[label] = enabled
                end
            end
        end
    end
end

local function saveAutoApplyStates()
    autoApplyEnvironment[autoApplyStorageKey] = persistentAutoApply

    if type(writefile) == "function" then
        pcall(function()
            writefile(autoApplyFile, HttpService:JSONEncode(persistentAutoApply))
        end)
    end
end

loadAutoApplyFile()
-- Migrate the previous Diamond Hands Auto setting to its Finisher label.
