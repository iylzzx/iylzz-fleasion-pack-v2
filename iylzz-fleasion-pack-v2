    and persistentAutoApply["Diamond Hands"] ~= nil then
    persistentAutoApply["Finisher: Diamond Hands"] = persistentAutoApply["Diamond Hands"]
    persistentAutoApply["Diamond Hands"] = nil
end
saveAutoApplyStates()

-- Shared Auto control used by every feature tab.
local function addAutoFeature(row, label, callback, statusLabel)
    local auto = make("TextButton", {
        Name = "AutoApplyButton",
        Size = UDim2.fromOffset(72, 28),
        Position = UDim2.new(1, -78, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(42, 48, 43),
        BorderSizePixel = 1,
        BorderColor3 = Color3.fromRGB(85, 105, 88),
        Text = "Auto: OFF",
        TextColor3 = Color3.fromRGB(235, 245, 235),
        TextSize = 10,
        Font = Enum.Font.Code,
        AutoButtonColor = true
    }, row)
    addCorner(auto, 0)

    local state = {
        enabled = persistentAutoApply[label] == true,
        button = auto,
        apply = callback
    }
    autoApplyStates[label] = state

    local function updateButton()
        auto.Text = state.enabled and "Auto: ON" or "Auto: OFF"
        auto.BackgroundColor3 = state.enabled
            and Color3.fromRGB(45, 105, 58)
            or Color3.fromRGB(42, 48, 43)
    end
    updateButton()

    auto.MouseButton1Click:Connect(function()
        state.enabled = not state.enabled
        persistentAutoApply[label] = state.enabled
        saveAutoApplyStates()

        if state.enabled then
            local ok, err = pcall(state.apply)
            if not ok then
                state.enabled = false
                persistentAutoApply[label] = false
                saveAutoApplyStates()
                warn("[Fleasion Pack [rivals]] Auto failed for " .. label .. ": " .. tostring(err))
                if statusLabel then statusLabel.Text = "Auto failed: " .. tostring(err) end
            elseif statusLabel then
                statusLabel.Text = "Auto enabled: " .. label
            end
        elseif statusLabel then
            statusLabel.Text = "Auto disabled: " .. label
        end
        updateButton()
    end)

    return auto
end

local function runVisual(source, label)
    local loader, compileError = loadstring(source)
    if not loader then
        error(compileError or ("Could not compile " .. label))
    end
    loader()
end

