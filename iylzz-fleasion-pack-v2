-- Save original local appearance so Unload All can restore our own changes.
local originalPartProperties = {}
local originalTextureProperties = {}
local originalSurfaceParents = {}

local function rememberPart(part)
    if not originalPartProperties[part] then
        originalPartProperties[part] = {
            Color = part.Color,
            Material = part.Material
        }
    end
end

-- Apply using the first-seen values, so replaying a round never
-- darkens the same part repeatedly.
local function applyDarkToPart(object)
    if not object:IsA("BasePart") then
        return
    end

    rememberPart(object)
    local original = originalPartProperties[object]
    object.Material = Enum.Material.SmoothPlastic
    object.Color = Color3.new(
        original.Color.R * 0.42,
        original.Color.G * 0.42,
        original.Color.B * 0.42
    )
end

local function applyDarkTexture()
    for _, object in ipairs(workspace:GetDescendants()) do
        applyDarkToPart(object)
    end
end

local function applyNoTextureToObject(object)
    if object:IsA("Decal") or object:IsA("Texture") then
        if originalTextureProperties[object] == nil then
            originalTextureProperties[object] = object.Transparency
        end
        object.Transparency = 1
    elseif object:IsA("SurfaceAppearance") then
        if originalSurfaceParents[object] == nil then
            originalSurfaceParents[object] = object.Parent
        end
        object.Parent = nil
    end
end

-- No Texture: hide texture instances client-side.
local function applyNoTexture()
    for _, object in ipairs(workspace:GetDescendants()) do
        applyNoTextureToObject(object)
    end
end

